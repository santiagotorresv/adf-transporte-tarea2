{
	"name": "df_silver_viajes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_viajes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "eliminarDuplicadosViajes"
				},
				{
					"name": "filtrarTotales"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(ViajeId = trim(ViajeId),",
				"          RutaHistoricaId = upper(trim(RutaHistoricaId)),",
				"          VehiculoId = upper(trim(VehiculoId)),",
				"          EstadoViaje = coalesce(upper(trim(EstadoViaje)), '')) ~> derivedColumn1",
				"derivedColumn1 derive(FechaServicio = iif(instr(trim(FechaServicio), '/') > 0, toDate(trim(FechaServicio), 'dd/MM/yyyy'), toDate(trim(FechaServicio), 'yyyy-MM-dd')),",
				"          HoraProgramada = iif(length(trim(toString(HoraProgramada))) == 5, iif(instr(toString(FechaServicio), '/') > 0, toTimestamp(concat(toString(FechaServicio), ' ', trim(toString(HoraProgramada))), 'dd/MM/yyyy HH:mm'), toTimestamp(concat(toString(FechaServicio), ' ', trim(toString(HoraProgramada))), 'yyyy-MM-dd HH:mm')), iif(instr(toString(HoraProgramada), '/') > 0, toTimestamp(trim(toString(HoraProgramada)), 'dd/MM/yyyy HH:mm:ss'), toTimestamp(trim(toString(HoraProgramada)), 'yyyy-MM-dd HH:mm:ss'))),",
				"          HoraSalida = iif(length(trim(toString(HoraSalida))) == 5, iif(instr(toString(FechaServicio), '/') > 0, toTimestamp(concat(toString(FechaServicio), ' ', trim(toString(HoraSalida))), 'dd/MM/yyyy HH:mm'), toTimestamp(concat(toString(FechaServicio), ' ', trim(toString(HoraSalida))), 'yyyy-MM-dd HH:mm')), iif(instr(toString(HoraSalida), '/') > 0, toTimestamp(trim(toString(HoraSalida)), 'dd/MM/yyyy HH:mm:ss'), toTimestamp(trim(toString(HoraSalida)), 'yyyy-MM-dd HH:mm:ss'))),",
				"          HoraLlegada = iif(length(trim(toString(HoraLlegada))) == 5, iif(instr(toString(FechaServicio), '/') > 0, toTimestamp(concat(toString(FechaServicio), ' ', trim(toString(HoraLlegada))), 'dd/MM/yyyy HH:mm'), toTimestamp(concat(toString(FechaServicio), ' ', trim(toString(HoraLlegada))), 'yyyy-MM-dd HH:mm')), iif(instr(toString(HoraLlegada), '/') > 0, toTimestamp(trim(toString(HoraLlegada)), 'dd/MM/yyyy HH:mm:ss'), toTimestamp(trim(toString(HoraLlegada)), 'yyyy-MM-dd HH:mm:ss'))),",
				"          ValidacionesTarjeta = coalesce(toInteger(trim(ValidacionesTarjeta)), 0),",
				"          KmRecorridos = coalesce(toDecimal(trim(KmRecorridos), 10, 2), toDecimal('0.00', 10, 2))) ~> derivedColumn2",
				"derivedColumn2 aggregate(groupBy(ViajeId),",
				"     AnioFuente = first(AnioFuente),",
				"          RutaHistoricaId = first(RutaHistoricaId, true()),",
				"          VehiculoId = first(VehiculoId, true()),",
				"          FechaServicio = first(FechaServicio),",
				"          HoraProgramada = first(HoraProgramada),",
				"          HoraSalida = first(HoraSalida),",
				"          HoraLlegada = first(HoraLlegada),",
				"          ValidacionesTarjeta = first(ValidacionesTarjeta),",
				"          KmRecorridos = first(KmRecorridos),",
				"          EstadoViaje = first(EstadoViaje)) ~> eliminarDuplicadosViajes",
				"eliminarDuplicadosViajes filter(ViajeId != 'TOTAL_OPERACION' && ViajeId != 'TOTAL_CANCELADOS') ~> filtrarTotales",
				"filtrarTotales sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}